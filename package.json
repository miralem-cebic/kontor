{
  "name": "kontor",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "verify": "npm run lint:md && npm run lint && npm test && npm run build && npm run check:file",
    "verify:full": "npm run verify && npm run test:e2e",
    "lint": "eslint . --max-warnings 0",
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"#**/node_modules\" \"#.claude/worktrees\"",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "check:file": "node scripts/check-file-protocol.mjs"
  },
  "dependencies": {
    "@cantoo/fontkit": "^2.0.12",
    "@cantoo/pdf-lib": "^2.11.1",
    "@expo-google-fonts/inter": "^0.4.2",
    "@fontsource/inter": "^5.3.0",
    "date-fns": "^4.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.6",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "markdownlint-cli2": "^0.24.0",
    "playwright-core": "^1.63.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
